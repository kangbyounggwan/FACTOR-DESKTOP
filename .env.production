# =============================================================
# factor-desktop — production env (npm run build / build:electron = vite build, mode=production)
#
# Vite 우선순위: .env.production > .env.local > .env
#   → 개발(npm run dev, mode=development)은 .env.local 의 로컬 값(127.0.0.1:8002)을 그대로 쓰고,
#     설치본(NSIS)에는 이 파일의 서버 주소가 박힌다.
# 이 파일은 git 에 커밋된다 — public 값만. 시크릿(서비스 롤 키 등) 절대 금지.
# =============================================================

# 이상탐지 model-server (anomaly-plugin, TimesFM) — EC2 nginx 경로.
# 서버 배포 절차: ../docs/anomaly-server-deploy.md
# 배포 전에는 설치본 /anomaly 화면이 "서버 연결 필요" 상태가 된다(정상).
VITE_ANOMALY_API_URL=https://api.factor.io.kr/anomaly-api
